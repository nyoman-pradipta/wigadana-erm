# ===== BACKEND ENV (copy ke .env) =====

# PostgreSQL
DATABASE_URL=postgresql+psycopg://erm:erm_password@localhost:5432/erm

# Redis (cache + nomor antrian)
REDIS_URL=redis://localhost:6379/0

# JWT secret — WAJIB, tanpa default. Minimal 32 karakter.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Masa berlaku token (menit). Default 12 jam.
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Origin frontend (dipisah koma). Vercel domain + local dev.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://erm-frontend.vercel.app

# Password seed user pertama (admin/dokter/suster) — OPSIONAL.
# Kalau kosong: password acak dicetak sekali ke stdout saat startup.
# SEED_ADMIN_PASSWORD=
# SEED_DOKTER_PASSWORD=
# SEED_SUSTER_PASSWORD=
